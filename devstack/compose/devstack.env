# Copie este arquivo para devstack.env e preencha os valores antes de executar make
# Sempre atualizar .env.example ao adicionar alguma variável

# ─── Banco de Dados ────────────────────────────────────────────────────────────

VAR_POSTGRES_PORT_HOST=5432
VAR_PGADMIN_PORT_HOST=5050
VAR_POSTGRES_USER=postgres
VAR_POSTGRES_PASSWORD=Admin123
VAR_POSTGRES_DB=praxis_db_dev
VAR_PGADMIN_DEFAULT_EMAIL=suasnapraxis@praxis.local
VAR_PGADMIN_DEFAULT_PASSWORD=Admin123
VAR_PGADMIN_CONFIG_SERVER_MODE="False"

# Hosts Proxies e Hosts de redirecionamento

VAR_NGINX_HTTP_PORT_HOST=80
VAR_NGINX_HTTPS_PORT_HOST=443
VAR_NGINX_WEBADMIN_PORT_HOST=81

# NGINX_PROXIES_PATH=/data
# NGINX_CERTS_PATH=/etc/letsencrypt
# NGINX_PROXIES_DATA=./data
# NGINX_CERTS_DATA=./letsencrypt

# Orquestração de containers

VAR_PORTAINER_HTTP_PORT_HOST=9443

